#!/usr/bin/env bash
# pre-push — run the full build + test suite before any push to origin.
#
# This is the gate that keeps origin/main from carrying a broken state
# that the iMac would pull and fail to build. Slow (~30 s) but only runs
# at push time, not commit time.
#
# Bypass with: git push --no-verify   (use sparingly)

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ ! -x "scripts/ci-build-test.sh" ]; then
    echo "pre-push: scripts/ci-build-test.sh missing or not executable — skipping."
    exit 0
fi

# Y1 — content-pack JSON round-trip check. Catches a stray edit script
# that ran with ensure_ascii=True (or wrong indent) before we waste CI
# minutes on a build.
if [ -x "scripts/verify_pack_roundtrip.py" ]; then
    echo "pre-push: pack JSON round-trip check"
    python3 scripts/verify_pack_roundtrip.py || exit 1
fi

# Honour CI_BUILD_TEST_FLAGS for opt-in UI tests. Set in your shell
# profile if this machine has granted Accessibility to the UI-test
# runner (typically: the iMac):
#   export CI_BUILD_TEST_FLAGS=--ui
# Dev Macs and CI runners without an AX grant leave it unset and get
# the default unit-only path. See scripts/install-git-hooks.sh for
# the install-time hint.
EXTRA_FLAGS="${CI_BUILD_TEST_FLAGS:-}"

if [ -n "$EXTRA_FLAGS" ]; then
    echo "pre-push: running scripts/ci-build-test.sh $EXTRA_FLAGS"
    bash scripts/ci-build-test.sh $EXTRA_FLAGS
else
    echo "pre-push: running scripts/ci-build-test.sh"
    bash scripts/ci-build-test.sh
fi
