#!/usr/bin/env bash
# pre-commit — static checks that must pass before any commit lands.
#
# Cheap only. Heavy work (build + tests) lives in pre-push. Anything that
# takes longer than ~3 seconds belongs in pre-push or CI.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 1) Refuse to commit obvious force-unwrap regressions in runtime paths.
#    Tests are exempt — XCTest assertions legitimately force unwraps.
STAGED_SWIFT=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '^desktopAhaan/.*\.swift$' \
    | grep -v 'FoundationTutor.swift' \
    || true)
if [ -n "$STAGED_SWIFT" ]; then
    FORBIDDEN=$(echo "$STAGED_SWIFT" | xargs grep -n -E '(try!|as!)' || true)
    if [ -n "$FORBIDDEN" ]; then
        echo "pre-commit: refusing — try! / as! found in staged runtime code:"
        echo "$FORBIDDEN"
        echo
        echo "If this is intentional, run with: git commit --no-verify"
        exit 1
    fi
fi

# 2) ViewBuilder ≤10 children static check (heuristic; ok if it over-flags).
if [ -f "scripts/check_viewbuilder_limit.py" ]; then
    if ! python3 scripts/check_viewbuilder_limit.py --quiet 2>/dev/null; then
        # The script prints details; fall through and let the dev decide.
        echo
        echo "pre-commit: ViewBuilder check flagged something — verify on Big Sur."
        echo "If false-positive, run with: git commit --no-verify"
        # Don't block; this is a heuristic. Comment out the next line to enforce.
        # exit 1
    fi
fi

# 3) SF Symbols 3+/4+ compat lint (deterministic — truth source is the
#    SFSymbolCompat map in Extensions.swift). A flagged literal renders
#    blank on the deploy iMac (Big Sur, SF Symbols 2). Hard gate.
if [ -f "scripts/check_sf_symbols_compat.py" ]; then
    if ! python3 scripts/check_sf_symbols_compat.py; then
        echo
        echo "pre-commit: SF Symbols compat check failed — these icons render blank on Big Sur."
        echo "Fix: wrap the literal in SFSymbolCompat.name(\"...\"), or add a case to the compat map."
        echo "If intentional (e.g., a Big Sur-safe glyph that shadows a 3+ name), bypass with: git commit --no-verify"
        exit 1
    fi
fi

# 3.5) macOS 12+ API lint (deterministic). Any banned SwiftUI modifier
#      mis-bridges through the AnyView dispatcher and can crash with
#      EXC_BAD_ACCESS even on macOS 14 dev Macs (commit 594e781 reintroduced
#      `.animation(_:value:)` on Van Helmont's Willow and crashed Try
#      Discover Mode on Ch.1 — that's the regression class this lint
#      blocks). Hard gate.
if [ -f "scripts/check_macos12_apis.py" ]; then
    if ! python3 scripts/check_macos12_apis.py; then
        echo
        echo "pre-commit: macOS 12+ API check failed — these APIs are forbidden by the Big Sur deploy target."
        echo "Fix: use the Big Sur equivalent listed in the lint output, or add a runtime #available guard."
        echo "If intentional, bypass with: git commit --no-verify"
        exit 1
    fi
fi

# 4) Pack schema lint — every concept + question + variation + match-pair
#    in science_class7 and sanskrit_class7 must satisfy the Swift
#    Decodable contract. The 2026-05-19 bug class (commit 6cdf722) landed
#    broken because variations were missing solutionSteps; this gate
#    catches the same family of mismatches at commit time, not at
#    test-run time. Hard gate — deterministic against the Swift schema.
#    Only runs when a pack JSON is staged.
PACK_STAGED=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '^desktopAhaan/Subjects/Packs/.+\.json$' || true)
if [ -n "$PACK_STAGED" ] && [ -f "scripts/check_pack_schema.py" ]; then
    if ! python3 scripts/check_pack_schema.py; then
        echo
        echo "pre-commit: pack schema lint failed — Swift Decodable won't accept this pack."
        echo "Fix the violations above before committing."
        echo "If intentional (e.g., schema is being intentionally extended), bypass with: git commit --no-verify"
        exit 1
    fi
fi

# 5a) Color-literal lint — flags Text widgets that use a system-primary
#     foreground colour (.yellow/.orange/.teal) which fails WCAG AA on
#     the canvas. Runs whenever a Swift file in desktopAhaan/ is staged.
#     Hard gate — the migration to BrandColor.* is a one-shot fix per site.
STAGED_DESKTOP_SWIFT=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '^desktopAhaan/.*\.swift$' || true)
if [ -n "$STAGED_DESKTOP_SWIFT" ] && [ -f "scripts/check_color_literals.py" ]; then
    if ! python3 scripts/check_color_literals.py $STAGED_DESKTOP_SWIFT > /dev/null; then
        # Re-run with output for the dev.
        python3 scripts/check_color_literals.py $STAGED_DESKTOP_SWIFT
        echo
        echo "pre-commit: color-literal lint failed — a Text widget uses a system-primary fg colour."
        echo "Fix: replace .foregroundColor(.yellow|.orange|.teal) with the matching"
        echo "       DesignTokens.BrandColor.* deep hue."
        echo "If intentional (e.g., proven icon-only context), bypass with: git commit --no-verify"
        exit 1
    fi
fi

# 5b) WCAG contrast audit — runs only when the BrandColor source file or
#    the audit script itself is staged. The script is deterministic so
#    a fast no-arg invocation gives us instant feedback when someone
#    edits a colour without re-checking contrast. Hard gate.
WCAG_TOUCHED=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '^(desktopAhaan/Extensions/Extensions\.swift|scripts/check_wcag_contrast\.py)$' \
    || true)
if [ -n "$WCAG_TOUCHED" ] && [ -f "scripts/check_wcag_contrast.py" ]; then
    if ! python3 scripts/check_wcag_contrast.py > /dev/null; then
        echo
        echo "pre-commit: WCAG contrast audit failed — at least one BrandColor pair is below AA."
        echo "Run scripts/check_wcag_contrast.py manually to see which pair, then deepen the colour"
        echo "in DesignTokens.BrandColor and the matching BRAND_* constant in the script."
        echo "If intentional (e.g., docs-only change), bypass with: git commit --no-verify"
        exit 1
    fi
fi

# 6) Lifetime-hazards lint — gates ownership patterns that cause
#    EXC_BAD_ACCESS / retain cycles / sendable lies. Distinct from the
#    SDK-compat lint (check_macos12_apis.py). Existing violations are
#    grandfathered via scripts/lifetime_hazards_allowlist.txt; new ones
#    are refused. Hard gate.
if [ -f "scripts/check_lifetime_hazards.py" ]; then
    if ! python3 scripts/check_lifetime_hazards.py; then
        echo
        echo "pre-commit: lifetime-hazards lint failed — a new ownership hazard would land."
        echo "Fix the violation, or — if it's a confirmed false positive — add the"
        echo "  file:line to scripts/lifetime_hazards_allowlist.txt with a short reason."
        echo "If intentional, bypass with: git commit --no-verify"
        exit 1
    fi
fi

# 7) File-size lint — refuses any new Swift file > 600 LOC under the
#    Big Sur Swift 5.5 type-checker timeout zone. Existing oversized
#    files are grandfathered via scripts/file_size_allowlist.txt; new
#    ones must split or earn an allowlist entry with a reason. Hard gate.
if [ -f "scripts/check_file_size.py" ]; then
    if ! python3 scripts/check_file_size.py; then
        echo
        echo "pre-commit: file-size lint failed — new file exceeds 600 LOC."
        echo "Big Sur Swift 5.5 type-checker can time out on files of this size."
        echo "Split along natural seams (sub-views to +Sections.swift, helpers to"
        echo "+Extensions), or — if genuinely indivisible — add the file to"
        echo "scripts/file_size_allowlist.txt with a short reason."
        echo "If intentional, bypass with: git commit --no-verify"
        exit 1
    fi
fi

# 8) Swift 5.5 syntax lint — refuses Swift 5.7+ shorthand bindings
#    (`if let foo {`, `guard let foo else`, `while let foo {`) that
#    compile silently on the dev Mac but hard-fail on the iMac with
#    "Variable binding in a condition requires an initializer". Hard
#    gate; bypass with --no-verify only if a guarded `#if swift(>=5.7)`
#    block needs to land.
if [ -f "scripts/check_swift55_syntax.py" ]; then
    if ! python3 scripts/check_swift55_syntax.py; then
        echo
        echo "pre-commit: Swift 5.5 syntax lint failed — Swift 5.7+ shorthand"
        echo "  binder would land. Expand 'if let foo {' to 'if let foo = foo {'."
        echo "If intentional (e.g. guarded by #if swift(>=5.7)), bypass with: git commit --no-verify"
        exit 1
    fi
fi

exit 0
